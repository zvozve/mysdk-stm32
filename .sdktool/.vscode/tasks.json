{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "cmake",
            "command": "build",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build & Flash",
            "type": "shell",
            "command": "${workspaceFolder}/../../../../Applications/Dev_STM32/my-stm32-sdk/.sdktool/flash.bat",
            "args": [
                "${config:jlink.root}",
                "${command:cmake.launchTargetPath}",
                "${config:jlink.device}",
                "${config:jlink.interface}",
                "${config:jlink.speed}",
                "${workspaceFolder}"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "${workspaceFolder}/../../../../Applications/Dev_STM32/my-stm32-sdk/.sdktool/flash.bat",
            "args": [
                "${config:jlink.root}",
                "${command:cmake.getLaunchTargetPath}",
                "${config:jlink.device}",
                "${config:jlink.interface}",
                "${config:jlink.speed}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
