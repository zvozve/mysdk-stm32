{
  "sdk": {
    "name": "mystm32-sdk",
    "version": "0.1.0",
    "schemaVersion": "1.0",
    "description": "自建 STM32 驱动/协议 SDK：片上寄存器 OOP 封装（基于 HAL）、板外设备驱动、协议封装、第三方中间件。镜像 Zephyr 的 zephyrproject，本地单源真相，按项目拷贝子集。",
    "repo": "C:/Container/Applications/Dev_STM32/mystm32-sdk",
    "license": "internal",
    "created": "2026-08-28"
  },
  "families": [
    {
      "id": "STM32G4",
      "name": "STM32G4 系列",
      "halMacro": "HAL_PLATFORM_G4",
      "halHeader": "stm32g4xx_hal.h",
      "note": "CubeMX 生成具体型号宏（如 STM32G474xx）自动展开。"
    },
    {
      "id": "STM32F4",
      "name": "STM32F4 系列",
      "halMacro": "HAL_PLATFORM_F4",
      "halHeader": "stm32f4xx_hal.h",
      "note": "F4  UART 空闲收帧需用 DMA 循环 + 自行空闲检测（G4 有 HAL_UARTEx_*）。"
    }
  ],
  "layers": {
    "chip": "MCU 内部外设 OOP 封装（基于 HAL，板无关）",
    "devices": "板载外挂芯片驱动（坐 chip/ 总线，不碰 MCU 寄存器）",
    "protocols": "协议封装 + 可复用算法库",
    "middleware": "第三方调试/传输库"
  },
  "modules": [
    {
      "id": "chip.bsp_dwt",
      "name": "bsp_dwt",
      "layer": "chip",
      "category": "timing",
      "version": "V2.0",
      "path": "chip/bsp_dwt",
      "description": "DWT 数据观察点与跟踪：延时/计时模块，支持 RTOS 与裸机。",
      "depends": [],
      "backends": ["hal"],
      "files": [
        "chip/bsp_dwt/Inc/bsp_dwt.h",
        "chip/bsp_dwt/Src/bsp_dwt.c"
      ]
    },
    {
      "id": "chip.bsp_gpio",
      "name": "bsp_gpio",
      "layer": "chip",
      "category": "gpio",
      "version": "V3.1",
      "updated": "2026-08-25",
      "path": "chip/bsp_gpio",
      "description": "GPIO OOP 驱动（drv 抽象 + drv_hal HAL 后端），上层注入句柄。",
      "depends": ["chip.platform"],
      "backends": ["hal"],
      "files": [
        "chip/bsp_gpio/Inc/bsp_gpio_drv.h",
        "chip/bsp_gpio/Src/bsp_gpio_drv.c",
        "chip/bsp_gpio/Src/bsp_gpio_drv_hal.c"
      ]
    },
    {
      "id": "chip.bsp_uart",
      "name": "bsp_uart",
      "layer": "chip",
      "category": "uart",
      "version": "V3.0",
      "updated": "2026-08-04",
      "path": "chip/bsp_uart",
      "description": "通用串口 DMA 驱动 + 状态机（IDLE/TX_BUSY/DATA_READY/ERROR），支持 RS485 使能脚注入、运行时波特率重配、UART1~UART8 描述表。",
      "depends": ["chip.platform"],
      "backends": ["hal"],
      "files": [
        "chip/bsp_uart/Inc/bsp_uart_drv.h",
        "chip/bsp_uart/Src/bsp_uart_drv.c",
        "chip/bsp_uart/Src/bsp_uart_drv_hal.c"
      ]
    },
    {
      "id": "chip.platform",
      "name": "hal_platform",
      "layer": "chip",
      "category": "porting",
      "version": "V1.0",
      "path": "chip/platform",
      "description": "STM32 系列 HAL 统一入口（移植层）。驱动/任务统一 include，换系列只需改编译宏，避免多处改头文件。导出 HAL_PLATFORM_G4 / HAL_PLATFORM_F4 平台宏供功能差异条件编译。",
      "depends": [],
      "backends": ["hal"],
      "files": [
        "chip/platform/Inc/hal_platform.h"
      ]
    },
    {
